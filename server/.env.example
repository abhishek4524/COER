# ─── Server Configuration ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database & Storage ──────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/personify
REDIS_URL=redis://127.0.0.1:6379

# ─── Security & Authentication ───────────────────────────────────────────────
CLIENT_ORIGIN=http://127.0.0.1:5173
JWT_SECRET=your_jwt_secret_here_change_in_production
ALLOW_UNVERIFIED_DEV=true

# ─── Google OAuth (Optional) ────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─── Email Service (Resend — Optional; logs link to console in dev if missing) ─
# RESEND_API_KEY=re_123456789
EMAIL_FROM=Personify Auth <noreply@personify.dev>

# ─── Razorpay Payments ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ─── LLM Configuration ───────────────────────────────────────────────────────
# LLM_PROVIDER: gemini | openrouter | openai
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Gemini alternative:
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# ─── Agent Execution & Demo Target ──────────────────────────────────────────
AGENT_CONCURRENCY=5
DEMO_PORT=3456
DEMO_URL=http://localhost:3456
