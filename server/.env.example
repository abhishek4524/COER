# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/personify

# ─── Redis (BullMQ) — optional, server degrades gracefully if offline ─────────
REDIS_URL=redis://127.0.0.1:6379

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://127.0.0.1:5173

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_change_in_production

# ─── LLM Configuration ────────────────────────────────────────────────────────
# Provider: gemini | openai | anthropic
LLM_PROVIDER=gemini

# Google Gemini (default)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (future use — set LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ─── Agent ────────────────────────────────────────────────────────────────────
# Number of parallel persona sessions to run at once
AGENT_CONCURRENCY=5

# ─── Demo site ────────────────────────────────────────────────────────────────
DEMO_PORT=3456
DEMO_URL=http://localhost:3456
